<ui:FluentWindow x:Class="MailSender.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="設定" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar Title="設定" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Margin="16,4,16,16">
            <ui:Card Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OAuth クライアント (client_secret.json)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Hint}"
                               Text="Google Cloud の「API とサービス &gt; 認証情報」で「デスクトップ アプリ」種別の OAuth クライアントを作り、その行の右端からダウンロードした JSON ファイルを選びます。Web アプリの共通送信者にも同じクライアントを使います。" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="JSON を選ぶ..." Icon="{ui:SymbolIcon Key24}" Style="{StaticResource ToolButton}" Click="OnBrowse" />
                        <ui:TextBox x:Name="_clientIdText" IsReadOnly="True" ClearButtonEnabled="False" />
                    </DockPanel>
                    <TextBlock x:Name="_secretState" Margin="0,6,0,0" Style="{StaticResource Hint}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="保存場所" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Hint}"
                               Text="設定 (settings.json)・アカウントのトークン (accounts.bin、暗号化)・送信ログ (logs) はこのフォルダにあります。アプリを消すときや全部やり直すときはフォルダごと削除してください。" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="フォルダを開く" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource ToolButton}" Click="OnOpenDataFolder" />
                        <ui:TextBox x:Name="_dataFolderText" IsReadOnly="True" ClearButtonEnabled="False" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="OK" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
                <ui:Button Content="キャンセル" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
