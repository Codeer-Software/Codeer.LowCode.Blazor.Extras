<Window x:Class="MailSender.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="OAuth クライアント ID" FontWeight="Bold" />
        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="#555"
                   Text="Google Cloud で「デスクトップ アプリ」種別の OAuth クライアントを作り、そのクライアント ID を入力します (client_secret は使いません)。" />
        <TextBox x:Name="_clientId" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" />
            <Button Content="キャンセル" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
