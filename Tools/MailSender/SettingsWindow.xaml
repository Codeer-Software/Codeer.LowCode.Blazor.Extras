<ui:FluentWindow x:Class="MailSender.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="設定" Width="700" SizeToContent="Height" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>
    </ui:FluentWindow.Resources>
    <StackPanel>
        <ui:TitleBar Title="設定" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Margin="16,4,16,16">
            <TextBlock Margin="0,0,0,10" Style="{StaticResource Hint}"
                       Text="アカウントを追加するときに使う、Google / Microsoft 側のアプリ登録です。SMTP はサーバー情報をアカウントごとに持つので、ここでの設定はありません。" />

            <TextBlock Text="Gmail — Google Cloud の「API とサービス &gt; 認証情報」の OAuth クライアント" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Hint}"
                       Text="ID とシークレットを入力します (作成直後の画面に表示される値)。両方登録すると、アカウントの追加時にどちらで発行するか選べます。送信時はそのアカウントを発行したクライアントを自動で使います。" />

            <!-- デスクトップ種別 -->
            <ui:Card Padding="16,12">
                <StackPanel>
                    <TextBlock Text="デスクトップ アプリ (個人が自分の名義で送る用)" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="クライアント ID" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="_desktopId" Margin="0,0,0,8" PlaceholderText="123456789012-xxxxxxxx.apps.googleusercontent.com" TextChanged="OnTextChanged" />
                        <TextBlock Grid.Row="1" Text="クライアント シークレット" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="_desktopSecret" PlaceholderText="GOCSPX-..." TextChanged="OnTextChanged" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="JSON を読み込む..." Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Secondary" Padding="10,4" Tag="desktop" Click="OnBrowse" />
                        <ui:Button x:Name="_desktopExport" Content="JSON を書き出す..." Icon="{ui:SymbolIcon Save24}" Appearance="Secondary" Padding="10,4" Margin="8,0,0,0" Tag="desktop" Click="OnExportJson" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Web 種別 -->
            <ui:Card Padding="16,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="ウェブ アプリケーション (Web アプリの共通送信者のトークンを発行する用)" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="クライアント ID" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="_webId" Margin="0,0,0,8" PlaceholderText="123456789012-xxxxxxxx.apps.googleusercontent.com" TextChanged="OnTextChanged" />
                        <TextBlock Grid.Row="1" Text="クライアント シークレット" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="_webSecret" PlaceholderText="GOCSPX-..." TextChanged="OnTextChanged" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="JSON を読み込む..." Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Secondary" Padding="10,4" Tag="web" Click="OnBrowse" />
                        <ui:Button x:Name="_webExport" Content="JSON を書き出す..." Icon="{ui:SymbolIcon Save24}" Appearance="Secondary" Padding="10,4" Margin="8,0,0,0" Tag="web" Click="OnExportJson"
                                   ToolTip="Web アプリの Gmail.ClientSecret に設定する形式 (client_secret.json 相当) で保存します" />
                    </StackPanel>
                    <ui:InfoBar x:Name="_webNote" Margin="0,10,0,0" Severity="Informational" IsOpen="True" IsClosable="False" Title="リダイレクト URI の登録" />
                </StackPanel>
            </ui:Card>

            <!-- Microsoft 365 (Graph) -->
            <TextBlock Text="Microsoft 365 — Microsoft Entra ID のアプリ登録" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ui:Card Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Microsoft 365 (職場・学校アカウントの本人名義で送る用)" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="アプリケーション (クライアント) ID" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="_graphClientId" Margin="0,0,0,8" PlaceholderText="00000000-0000-0000-0000-000000000000" TextChanged="OnTextChanged" />
                        <TextBlock Grid.Row="1" Text="テナント" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="_graphTenantId" PlaceholderText="organizations" TextChanged="OnTextChanged"
                                    ToolTip="organizations = 任意の職場・学校アカウント / common = 個人アカウントも / テナント ID = 自組織のみ。アプリ登録の「サポートされているアカウントの種類」に合わせます" />
                    </Grid>
                    <ui:InfoBar Margin="0,10,0,0" Severity="Informational" IsOpen="True" IsClosable="False" Title="アプリ登録の設定"
                                Message="認証: プラットフォーム「モバイル アプリケーションとデスクトップ アプリケーション」に http://localhost を追加し、「パブリック クライアント フローを許可する」を「はい」に。&#x0a;API のアクセス許可: Microsoft Graph の委任されたアクセス許可 Mail.Send と User.Read。&#x0a;シークレットは使いません (本人がサインインして同意します)。" />
                </StackPanel>
            </ui:Card>

            <!-- 保存場所 -->
            <ui:Card Padding="16,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="保存場所" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Hint}"
                               Text="設定 (settings.json)・アカウントのトークンと SMTP パスワード (accounts.bin、暗号化)・送信ログ (logs) はこのフォルダにあります。アプリを消すときや全部やり直すときはフォルダごと削除してください。" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="フォルダを開く" Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource ToolButton}" Click="OnOpenDataFolder" />
                        <ui:TextBox x:Name="_dataFolderText" IsReadOnly="True" ClearButtonEnabled="False" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="OK" Appearance="Primary" IsDefault="True" MinWidth="96" Click="OnOk" />
                <ui:Button Content="キャンセル" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
