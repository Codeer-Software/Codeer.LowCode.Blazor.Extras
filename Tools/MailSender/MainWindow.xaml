<ui:FluentWindow x:Class="MailSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MailSender" Width="1120" Height="740" MinWidth="900" MinHeight="520"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewMouseWheel="OnPreviewMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="MailSender" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Mail24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="_zoom" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 差出人 (アカウント) -->
            <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="16,12">
                <StackPanel>
                    <!-- 1 行目: 見出し + アカウントに依らない操作 (追加 / 設定) -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="_addButton" Content="アカウントを追加" Icon="{ui:SymbolIcon PersonAdd24}" Style="{StaticResource ToolButton}" Click="OnAddAccount" />
                            <ui:Button x:Name="_settingsButton" Content="設定" Icon="{ui:SymbolIcon Settings24}" Style="{StaticResource ToolButton}" Click="OnSettings" />
                        </StackPanel>
                        <TextBlock Text="差出人 (アカウント)" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- 2 行目: 選択中のアカウント + そのアカウントへの操作 (再発行 / 書き出し / 破棄) -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="_reissueButton" Content="再発行" Icon="{ui:SymbolIcon ArrowSync24}" Style="{StaticResource ToolButton}" Click="OnReissueToken" />
                            <ui:Button x:Name="_exportButton" Content="トークンを書き出す" Icon="{ui:SymbolIcon ArrowExportLtr24}" Style="{StaticResource ToolButton}" Click="OnExportToken" />
                            <ui:Button x:Name="_revokeButton" Content="破棄" Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource ToolButton}" Click="OnRevokeToken" />
                        </StackPanel>
                        <ComboBox x:Name="_accountsCombo" MinWidth="240" Margin="0,0,8,0" VerticalAlignment="Center" SelectionChanged="OnAccountSelected" />
                    </DockPanel>
                    <TextBlock x:Name="_accountText" Margin="0,6,0,0" Style="{StaticResource Hint}" />
                </StackPanel>
            </ui:Card>

            <!-- パッケージ -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16,12">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" x:Name="_openButton" Content="プレビュー HTML を開く" Icon="{ui:SymbolIcon FolderOpen24}"
                               Style="{StaticResource ToolButton}" VerticalAlignment="Center" Click="OnOpen" />
                    <StackPanel>
                        <TextBlock Text="送信パッケージ (Web でダウンロードしたプレビュー HTML)" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="_packageText" Text="ファイルを開くか、このウィンドウにドロップしてください" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>
            </ui:Card>

            <!-- 一覧 + 本文 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <ui:Card Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button x:Name="_selectAllButton" Content="すべて選択" Icon="{ui:SymbolIcon SelectAllOn24}" Appearance="Secondary" Padding="10,4" Click="OnSelectAll" />
                            <ui:Button x:Name="_clearAllButton" Content="すべて解除" Icon="{ui:SymbolIcon SelectAllOff24}" Appearance="Secondary" Padding="10,4" Margin="8,0,0,0" Click="OnClearAll" />
                        </StackPanel>
                        <ui:ListView x:Name="_items" SelectionChanged="OnItemSelected" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="送信" Width="52">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" MinWidth="0" Padding="0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="宛先" Width="200" DisplayMemberBinding="{Binding To}" />
                                    <GridViewColumn Header="件名" Width="220" DisplayMemberBinding="{Binding Subject}" />
                                    <GridViewColumn Header="状態" Width="200" DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ui:ListView>
                    </DockPanel>
                </ui:Card>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <ui:Card Grid.Column="2" Padding="12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="_bodyHeader" Text="本文" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Bottom" x:Name="_bodyNote" Margin="0,6,0,0" Style="{StaticResource Hint}" Visibility="Collapsed"
                                   Text="HTML メール: 外部画像・リンク先は読み込みません (開封検知の誤発火防止)" />
                        <Grid>
                            <ui:TextBox x:Name="_body" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                        VerticalScrollBarVisibility="Auto" FontFamily="Consolas, MS Gothic" ClearButtonEnabled="False" />
                            <Border x:Name="_bodyHtmlFrame" Visibility="Collapsed" BorderThickness="1" CornerRadius="4" Background="White"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <wv2:WebView2 x:Name="_bodyHtml" Margin="1" />
                            </Border>
                        </Grid>
                    </DockPanel>
                </ui:Card>
            </Grid>

            <!-- 送信 -->
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="_cancelButton" Content="中止" Icon="{ui:SymbolIcon Stop24}" Style="{StaticResource ToolButton}" IsEnabled="False" Click="OnCancel" />
                    <ui:Button x:Name="_sendButton" Content="送信" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Style="{StaticResource ToolButton}"
                               FontWeight="SemiBold" Padding="18,6" Click="OnSend" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="_statusText" TextWrapping="Wrap" />
                    <ProgressBar x:Name="_progress" Height="6" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
