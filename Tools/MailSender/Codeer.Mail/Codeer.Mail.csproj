<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MailSender アプリ専用の送信部品。Gmail (REST + OAuth) / Microsoft Graph (REST + OAuth) / SMTP (MailKit) と、
    共通の MIME 組み立て・OAuth ループバック受信。
    Codeer.LowCode.Blazor にも Extras の製品コードにも依存せず、製品側もこれを参照しない (アプリは製品と独立)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

</Project>
