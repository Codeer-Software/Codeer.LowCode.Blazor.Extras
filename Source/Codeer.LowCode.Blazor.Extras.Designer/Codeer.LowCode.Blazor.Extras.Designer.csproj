<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Version>0.8.2</Version>
    <Authors>Codeer</Authors>
    <Company>Codeer</Company>
    <Description>Designer support for Codeer.LowCode.Blazor.Extras. Provides property controls and initializers for the LowCode Designer application.</Description>
    <PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Blazor;LowCode;Codeer;Designer</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Dependency update: Codeer.LowCode.Blazor.Extras 0.8.2, Codeer.LowCode.Blazor 1.3.27 and Codeer.LowCode.Blazor.Designer 1.3.27. No functional change.</PackageReleaseNotes>
    <PackageId>Codeer.LowCode.Blazor.Extras.Designer</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.27" />
    <PackageReference Include="Codeer.LowCode.Blazor.Designer" Version="1.3.27" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
  </ItemGroup>

	<!-- AI 用ドキュメントの埋め込み。.md はこの Extras.Designer プロジェクトに物理配置する
	     (実装ランタイムの WASM には配信しないため)。埋め込み先もこのアセンブリ。
	     FieldDocs は FieldCatalog.AddDocAssembly、ScriptObjectDocs は ExtrasScriptObjectDocs が読む。 -->
	<ItemGroup>
		<None Remove="FieldDocs\**\*.md" />
		<None Remove="ScriptObjectDocs\**\*.md" />
		<None Remove="ListElementComponentDocs\**\*.md" />
		<EmbeddedResource Include="FieldDocs\**\*.md">
			<LogicalName>Codeer.LowCode.Blazor.Extras.Designer.FieldDocs.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="ScriptObjectDocs\**\*.md">
			<LogicalName>Codeer.LowCode.Blazor.Extras.Designer.ScriptObjectDocs.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="ListElementComponentDocs\**\*.md">
			<LogicalName>Codeer.LowCode.Blazor.Extras.Designer.ListElementComponentDocs.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- セットアップ用モジュールテンプレート。正本は Example のデザイン (実機確認済み) で、
	     ここからリンク埋め込みする (SetupTemplates.Load と連動)。Example の承認モジュールを変更すると
	     生成されるテンプレートも変わる = Example がテンプレートの回帰テストを兼ねる。 -->
	<ItemGroup>
		<EmbeddedResource Include="..\Example\Design\Modules\ApprovalFlow.mod.json;..\Example\Design\Modules\ApprovalFlowMember.mod.json;..\Example\Design\Modules\ApprovalHistory.mod.json;..\Example\Design\Modules\MyApprovalList.mod.json;..\Example\Design\Modules\MyApprovalList.mod.cs;..\Example\Design\Modules\MyApprovalList.Query.sql;..\Example\Design\Modules\ApprovalStatusList.mod.json;..\Example\Design\Modules\ApprovalStatusList.mod.cs;..\Example\Design\Modules\ApprovalStatusList.Query.sql;..\Example\Design\Modules\ApprovalRoute.mod.json;..\Example\Design\Modules\ApprovalRoute.mod.cs;..\Example\Design\Modules\ApprovalRouteStep.mod.json;..\Example\Design\Modules\ApprovalRouteStepMember.mod.json">
			<LogicalName>Codeer.LowCode.Blazor.Extras.Designer.SetupTemplates.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
