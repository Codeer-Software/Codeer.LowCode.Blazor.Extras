<UserControl x:Class="Codeer.LowCode.Blazor.Extras.Designer.Controls.ApprovalFlowSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:match="clr-namespace:Codeer.LowCode.Blazor.Designer.Match;assembly=Codeer.LowCode.Blazor.Designer"
             xmlns:controls="clr-namespace:Codeer.LowCode.Blazor.Extras.Designer.Controls"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="400">
  <UserControl.Resources>
    <match:SearchControlViewModelConverter x:Key="ViewModelConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid d:DataContext="{d:DesignInstance Type={x:Type controls:ApprovalFlowSearchControlViewModel}}"
        DataContext="{Binding Converter={StaticResource ViewModelConverter},ConverterParameter={x:Type controls:ApprovalFlowSearchControlViewModel}}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <!-- 条件の種類: 状態 / 申請者 / 現在の承認待ち / 最終承認の番 -->
    <ComboBox MinWidth="130" VerticalAlignment="Center"
              ItemsSource="{Binding KindItems}" DisplayMemberPath="Label"
              SelectedValuePath="Kind" SelectedValue="{Binding Kind.Value,Mode=TwoWay}" />

    <!-- 状態: 複数選択 (未申請 = null 検索を含む) -->
    <ItemsControl Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                  ItemsSource="{Binding States}"
                  Visibility="{Binding IsStateKind.Value,Converter={StaticResource BoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <CheckBox Margin="0,2,10,2" Content="{Binding Label}"
                    IsChecked="{Binding IsChecked.Value,Mode=TwoWay}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 申請者 / 承認者ユーザーの比較変数 (既定 = 現在ユーザーの Id) -->
    <ComboBox Grid.Column="1" Margin="6,0,0,0" IsEditable="True"
              Text="{Binding Variable.Value,Mode=TwoWay}" ItemsSource="{Binding VariableCandidates}"
              Visibility="{Binding IsVariableKind.Value,Converter={StaticResource BoolToVis}}" />
  </Grid>
</UserControl>
