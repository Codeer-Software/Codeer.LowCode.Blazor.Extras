<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Codeer.LowCode.Blazor.Extras.SeleniumDrivers</PackageId>
    <Description>Selenium drivers for the fields of Codeer.LowCode.Blazor.Extras. Used together with Codeer.LowCode.Blazor.SeleniumDrivers.</Description>
    <PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
    <PackageTags>Codeer.LowCode.Blazor;Selenium</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Drivers for the edit history fields (Codeer.LowCode.Blazor.Extras 0.16.0): EditHistoryFieldDriver (versions with number / change type / user / date / summary, open a version to read its changes and press Show or Restore, LoadMore), EditHistoryVersionDialogDriver (counts of highlighted cells and rows in the version dialog), EditHistoryRestoreButtonFieldDriver and EditHistoryTargetLinkFieldDriver. EditHistoryVersionDriver: HasCommand / Command / OpenCommand for the "Submitted data" of a version.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor.SeleniumDrivers" Version="0.28.0" />
  </ItemGroup>

</Project>
