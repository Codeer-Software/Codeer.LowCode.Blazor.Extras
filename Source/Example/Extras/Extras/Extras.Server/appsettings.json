{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mail": {
    "DefaultInfraName": "Gmail",
    "DefaultBulkInfraName": "Gmail",
    "HistoryModuleName": "MailHistory"
  },
  "DataSources": [
    {
      "Name": "SampleSQLite",
      "DataSourceType": "SQLite"
    }
  ],
  "AuditLog": {
    "Enabled": true,
    "FailureMode": "Strict",
    "Database": { "DataSourceName": "SampleSQLite", "Table": "audit_log" }
  },
  "DataChangeHistoryTableInfo": [
    {
      "DataSourceName": "",
      "Table": "data_change_histories",
      "IdColumn": "id",
      "TransactionIdColumn": "transaction_id",
      "SubmitIdColumn": "submit_id",
      "UserIdColumn": "user_id",
      "TableNameColumn": "table_name",
      "AppNameColumn": "app_name",
      "DataSourceNameColumn": "data_source_name",
      "ModuleNameColumn": "form_name",
      "DataIdColumn": "data_id",
      "DataChangeTypeColumn": "type",
      "DataColumn": "data",
      "SubmitDataColumn": "submit_data",
      "DateTimeColumn": "date_time"
    }
  ],
  "TemporaryFileTableInfo": [
    {
      "DataSourceName": "SampleSQLite",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    }
  ],
  "Jobs": {
    "UserId": ""
  },
  "WebApi": {
    "Connections": [
      { "Name": "JsonPlaceholder", "BaseUrl": "https://jsonplaceholder.typicode.com/" },
      {
        "Name": "Crm",
        "BaseUrl": "https://api.example.com/v1/",
        "Authentication": "ApiKey",
        "ApiKey": { "HeaderName": "X-Api-Key", "Key": "dummy-key" }
      }
    ]
  }
}