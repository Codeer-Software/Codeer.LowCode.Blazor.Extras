{
  "Name": "ApprovalFlow",
  "DataSourceName": "SampleSQLite",
  "DbTable": "approval_flows",
  "CanCreate": true,
  "CanUpdate": true,
  "CanDelete": true,
  "Fields": [
    {
      "Name": "Id",
      "DbColumn": "id",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.IdFieldDesign"
    },
    {
      "Name": "Status",
      "DbColumn": "status",
      "EnumName": "ApprovalFlowStatus",
      "AllowEmptySearch": true,
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.SelectFieldDesign"
    },
    {
      "Name": "TargetModuleName",
      "DbColumn": "target_module_name",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "TargetId",
      "DbColumn": "target_id",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "RouteName",
      "DbColumn": "route_name",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "Applicant",
      "DbColumn": "applicant",
      "SearchCondition": {
        "ModuleName": "AppUser",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "ValueVariable": "Id.Value",
      "DisplayTextVariable": "Name.Value",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LinkFieldDesign"
    },
    {
      "Name": "AttemptNo",
      "DbColumn": "attempt_no",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.NumberFieldDesign"
    },
    {
      "Name": "CurrentStepNo",
      "DbColumn": "current_step_no",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.NumberFieldDesign"
    },
    {
      "Name": "Members",
      "SearchCondition": {
        "ModuleName": "ApprovalFlowMember",
        "Condition": {
          "SearchTargetVariable": "Flow.Value",
          "Comparison": "Equal",
          "Variable": "Id.Value",
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldVariableMatchCondition"
        },
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.ListFieldDesign"
    },
    {
      "Name": "Histories",
      "SearchCondition": {
        "ModuleName": "ApprovalHistory",
        "Condition": {
          "SearchTargetVariable": "Flow.Value",
          "Comparison": "Equal",
          "Variable": "Id.Value",
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldVariableMatchCondition"
        },
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.ListFieldDesign"
    },
    {
      "Name": "OptimisticLocking",
      "DbColumn": "version",
      "IncrementVersion": true,
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.OptimisticLockingFieldDesign"
    },
    {
      "Name": "Contract",
      "TypeFullName": "Codeer.LowCode.Blazor.Extras.Designs.ApprovalFlowContractFieldDesign"
    }
  ],
  "UserWriteCondition": {
    "ModuleName": "AppUser",
    "Condition": {
      "SearchTargetVariable": "Id.Value",
      "Comparison": "Equal",
      "Value": {
        "Value": "__nobody__",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.StringValue"
      },
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldValueMatchCondition"
    }
  },
  "ListLayouts": {
    "": {
      "Elements": [
        [
          {
            "FieldName": "Status",
            "Label": "状態"
          },
          {
            "FieldName": "TargetModuleName",
            "Label": "申請書"
          },
          {
            "FieldName": "TargetId",
            "Label": "Id"
          },
          {
            "FieldName": "RouteName",
            "Label": "経路"
          },
          {
            "FieldName": "AttemptNo",
            "Label": "試行"
          }
        ]
      ]
    }
  }
}