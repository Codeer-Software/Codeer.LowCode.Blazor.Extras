{
  "Name": "ApprovalHistory",
  "DataSourceName": "SampleSQLite",
  "DbTable": "approval_histories",
  "CanCreate": true,
  "CanUpdate": true,
  "CanDelete": true,
  "Fields": [
    {
      "Name": "Id",
      "DbColumn": "id",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.IdFieldDesign"
    },
    {
      "Name": "Flow",
      "DbColumn": "flow_id",
      "SearchCondition": {
        "ModuleName": "ApprovalFlow",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "ValueVariable": "Id.Value",
      "DisplayTextVariable": "Status.Value",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LinkFieldDesign"
    },
    {
      "Name": "AttemptNo",
      "DbColumn": "attempt_no",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.NumberFieldDesign"
    },
    {
      "Name": "StepNo",
      "DbColumn": "step_no",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.NumberFieldDesign"
    },
    {
      "Name": "Action",
      "DbColumn": "action",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "ActorUser",
      "DbColumn": "actor_user",
      "SearchCondition": {
        "ModuleName": "AppUser",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "ValueVariable": "Id.Value",
      "DisplayTextVariable": "Name.Value",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LinkFieldDesign"
    },
    {
      "Name": "FromStatus",
      "DbColumn": "from_status",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "ToStatus",
      "DbColumn": "to_status",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "Comment",
      "DbColumn": "comment",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "ActedAt",
      "DbColumn": "acted_at",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.DateTimeFieldDesign"
    }
  ],
  "UserWriteCondition": {
    "ModuleName": "AppUser",
    "Condition": {
      "SearchTargetVariable": "Id.Value",
      "Comparison": "Equal",
      "Value": {
        "Value": "__nobody__",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.StringValue"
      },
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldValueMatchCondition"
    }
  }
}