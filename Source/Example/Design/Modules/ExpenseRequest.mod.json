{
  "Name": "ExpenseRequest",
  "DataSourceName": "SampleSQLite",
  "DbTable": "expense_requests",
  "CanCreate": true,
  "CanUpdate": true,
  "CanDelete": true,
  "Fields": [
    {
      "Name": "Id",
      "DbColumn": "id",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.IdFieldDesign"
    },
    {
      "Name": "Title",
      "DbColumn": "title",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign",
      "Placeholder": "件名",
      "IsRequired": true
    },
    {
      "Name": "Amount",
      "DbColumn": "amount",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.NumberFieldDesign",
      "Placeholder": "金額"
    },
    {
      "Name": "Approver1",
      "DbColumn": "approver1",
      "SearchCondition": {
        "ModuleName": "AppUser",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "ValueVariable": "Id.Value",
      "DisplayTextVariable": "Name.Value",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LinkFieldDesign"
    },
    {
      "Name": "Approver2",
      "DbColumn": "approver2",
      "SearchCondition": {
        "ModuleName": "AppUser",
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "ValueVariable": "Id.Value",
      "DisplayTextVariable": "Name.Value",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LinkFieldDesign"
    },
    {
      "Name": "Approval",
      "DbColumn": "approval_id",
      "FlowModuleName": "ApprovalFlow",
      "TypeFullName": "Codeer.LowCode.Blazor.Extras.Designs.ApprovalFlowFieldDesign",
      "OnBuildRoute": "OnBuildRoute"
    },
    {
      "Name": "TitleLabel",
      "Text": "件名",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Name": "AmountLabel",
      "Text": "金額",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Name": "Approver1Label",
      "Text": "一次承認者",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Name": "Approver2Label",
      "Text": "二次承認者(任意)",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    }
  ],
  "PageTitle": "経費申請",
  "DataWriteCondition": {
    "ModuleName": "ExpenseRequest",
    "Condition": {
      "IsOrMatch": true,
      "Children": [
        {
          "SearchTargetVariable": "Approval.Status.Value",
          "Comparison": "Equal",
          "Value": {
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.NullValue"
          },
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldValueMatchCondition"
        },
        {
          "SearchTargetVariable": "Approval.Status.Value",
          "Comparison": "Equal",
          "Value": {
            "Value": "Returned",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.StringValue"
          },
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldValueMatchConditionNonNull"
        },
        {
          "SearchTargetVariable": "Approval.Status.Value",
          "Comparison": "Equal",
          "Value": {
            "Value": "Withdrawn",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.StringValue"
          },
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldValueMatchConditionNonNull"
        },
        {
          "SearchTargetVariable": "Approval.Status.Value",
          "Comparison": "Equal",
          "Value": {
            "Value": "Rejected",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.StringValue"
          },
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldValueMatchConditionNonNull"
        }
      ],
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.MultiMatchCondition"
    }
  },
