      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.TextFieldDesign"
    },
    {
      "Name": "Steps",
      "SearchCondition": {
        "ModuleName": "ApprovalSimpleRouteStep",
        "Condition": {
          "IsOrMatch": false,
          "IsNot": false,
          "Children": [
            {
              "SearchTargetVariable": "Route.Value",
              "Comparison": "Equal",
              "Variable": "Id.Value",
              "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.FieldVariableMatchCondition"
            }
          ],
          "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.MultiMatchCondition"
        },
        "SortConditions": [
          {
            "Variable": "StepNo.Value",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SortCondition"
          }
        ],
        "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.SearchCondition"
      },
      "CanCreate": true,
      "CanUpdate": true,
      "CanDelete": true,
      "DeleteTogether": true,
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.ListFieldDesign"
    },
    {
      "Name": "Contract",
      "TypeFullName": "Codeer.LowCode.Blazor.Extras.Designs.ApprovalRouteContractFieldDesign"
    },
    {
      "Name": "RouteNameLabel",
      "Text": "経路名",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Name": "SubmitButton",
      "Text": "保存",
      "Variant": "Primary",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.SubmitButtonFieldDesign"
    }
  ],
  "PageTitle": "承認経路マスタ (シンプル)",
  "DetailLayouts": {
