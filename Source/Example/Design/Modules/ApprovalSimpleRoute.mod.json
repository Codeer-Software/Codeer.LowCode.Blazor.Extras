{
  "Name": "ApprovalSimpleRoute",
  "DataSourceName": "SampleSQLite",
  "DbTable": "approval_simple_routes",
  "CanCreate": true,
  "CanUpdate": true,
  "CanDelete": true,
  "Fields": [
    {
      "Name": "Id",
      "DbColumn": "id",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.IdFieldDesign"
    },
    {
      "Name": "RouteName",
      "DbColumn": "route_name",
      "Placeholder": "経路名",
