<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.8.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Server-side services for Codeer.LowCode.Blazor apps. Includes AI document analysis (Azure Document Intelligence + Azure OpenAI), SMTP mail sending, file storage (file system / Azure Blob), and ASP.NET Core helpers (hot reload, ETag file responses).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;AI;Mail;Excel;PDF</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>FileField storage: added Amazon S3 (S3FileStorage / S3StorageSettings), including S3-compatible services such as MinIO, Cloudflare R2 and Wasabi via ServiceUrl; credentials come from the AWS default credential chain (IAM role, environment variables or a named profile via ProfileName), never from appsettings. Storage backends are now separate IFileStorage implementations (FileSystemFileStorage / AzureBlobFileStorage / S3FileStorage), each with its own settings class read from its own appsettings section; AzureBlobStorageSettings connects with a connection string, or - when ConnectionString is empty - with DefaultAzureCredential (Managed Identity, Azure CLI login, ...) against BlobServiceUri, and TemporaryFileManager / StorageAccess accept IFileStorage instances; custom storages implement IFileStorage. The existing single-class configuration (FileStorage[] / "FileStorages" section) keeps working unchanged for FileSystem and Azure Blob (FileStorage.ToFileStorage converts it); S3 is configured with S3StorageSettings.
Mail: SmtpMailSender / SmtpSettings are now public (verified by real sending). Wire them in the app's MailSenderTable as another infrastructure name (e.g. "Smtp") alongside Gmail.
Mail: GraphApiMailSender / GraphApiSettings (Microsoft Graph sendMail, application permission Mail.Send) are now public (verified by real sending). Authentication is client credentials when ClientSecret is set, or DefaultAzureCredential (Managed Identity, Azure CLI login, ...) when ClientSecret is empty, so no secret needs to be stored in appsettings on Azure hosting. Wire it in MailSenderTable as e.g. "GraphApi".</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras.Server</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- internal のテストのみに許可 (製品アセンブリへの IVT は不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- メールプレビュー HTML (MailPreviewHtml が埋め込みから読む) -->
		<EmbeddedResource Include="Mail\MailPreview.html" LogicalName="Codeer.LowCode.Blazor.Extras.Server.Mail.MailPreview.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
		<PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.32.0" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
