<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.7.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Server-side services for Codeer.LowCode.Blazor apps. Includes AI document analysis (Azure Document Intelligence + Azure OpenAI), SMTP mail sending, file storage (file system / Azure Blob), and ASP.NET Core helpers (hot reload, ETag file responses).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;AI;Mail;Excel;PDF</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Gmail sender: bulk sends keep a minimum interval between messages, retry rate-limit (429) and temporary (503) responses with exponential backoff honouring Retry-After, and stop the remaining recipients as failures once the daily sending quota is exceeded. MailProviderSettings.MaxBulkCount defaults to 500 (Gmail daily limit). BREAKING: MailDispatcher no longer takes a current-user resolver and GmailApiMailSender no longer takes a per-user refresh token resolver (MailCurrentUserResolver, GmailUserTokenStore, GmailTokenHelper, GmailTokenProtector and GmailTokenIssuer are removed; GmailSettings.TokenEncryptionKey is gone). Mails are always sent as the infrastructure's system sender. GmailSettings.ClientSecret / TokenSecret: a value ending with ".json" is read as a file path, anything else is used as the content itself (JSON, or for TokenSecret a bare refresh token), so the secrets can live in environment variables instead of files. Preview HTML now also embeds the attachment contents (attachmentFiles) and a packageVersion, so it doubles as the send package for the Windows MailSender app (Tools/MailSender) that sends from the user's own Gmail with a token kept on the PC.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras.Server</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- internal のテストのみに許可 (製品アセンブリへの IVT は不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- メールプレビュー HTML (MailPreviewHtml が埋め込みから読む) -->
		<EmbeddedResource Include="Mail\MailPreview.html" LogicalName="Codeer.LowCode.Blazor.Extras.Server.Mail.MailPreview.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
		<PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.32.0" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
