<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.15.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Server-side services for Codeer.LowCode.Blazor apps. Includes AI document analysis (Azure Document Intelligence + Azure OpenAI), mail sending (SMTP / Microsoft Graph / SendGrid / Gmail), file storage (file system / Azure Blob / S3), external logins (Entra ID / Google / AWS Cognito / OIDC), TOTP two-factor authentication, and ASP.NET Core helpers (hot reload, ETag file responses).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;AI;Mail;Excel;PDF;OpenIdConnect;EntraID</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>New: EditHistoryRecorder for EditHistoryField (Codeer.LowCode.Blazor.Extras 0.16.0). Create it in the ModuleDataIO subclass (new EditHistoryRecorder(designData, this, AddSystemRecordAsync, logError)) and wrap SubmitAsync with recorder.SubmitAsync(transactionData, () =&gt; base.SubmitAsync(transactionId, transactionData)) as in the app templates. For every root record of a submit whose module has an EditHistoryField it writes one row into the history module named by the field: for a delete the record as it was before (read before the base submit), for a create or update the record as saved (read back after the base submit, with the owned records loaded recursively without paging). The read-back uses the permissions of the current user, so columns the user cannot read are not in the snapshot; the history row is written through the internal add path so the user needs no write permission on the history module. A failure to record makes the submit fail (rollback), and so does a module whose history module or contract is missing. Rows added through the multi-row INSERT path (BulkAddThreshold) are not recorded because their Ids are not returned; this is logged. ExecuteSqlField saves are recorded too: Update and Delete timings as usual, a Create timing only when NewId returns the new Id, and a Standalone submit (SQL only, no rows) only when the record itself changed (the record is compared before and after). Requires Codeer.LowCode.Blazor.Extras 0.16.0. The recorder also performs the undeletes requested by the client (EditHistoryUndeleteData in ModuleSubmitData.ExtendedData) through ModuleDataIO.UndeleteAsync of Codeer.LowCode.Blazor 1.3.37 before the base submit, so revived rows are updated in the same transaction; a restored record is recorded as a Restore version. The snapshot is read with ModuleDataIO.GetWithOwnedRecordsAsync of Codeer.LowCode.Blazor 1.3.37 (owned records declared by IOwnedRecordsFieldDesign, recursively).</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras.Server</PackageId>
		<!-- NU5104: Azure.AI.OpenAI has no stable release built for the OpenAI 2.9+ line yet, so the prerelease dependency is intentional -->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- internal のテストのみに許可 (製品アセンブリへの IVT は不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- メールプレビュー HTML (MailPreviewHtml が埋め込みから読む) -->
		<EmbeddedResource Include="Mail\MailPreview.html" LogicalName="Codeer.LowCode.Blazor.Extras.Server.Mail.MailPreview.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
		<PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.36.0" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Markdig" Version="0.37.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.8" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
