<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.14.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Server-side services for Codeer.LowCode.Blazor apps. Includes AI document analysis (Azure Document Intelligence + Azure OpenAI), mail sending (SMTP / Microsoft Graph / SendGrid / Gmail), file storage (file system / Azure Blob / S3), external logins (Entra ID / Google / AWS Cognito / OIDC), TOTP two-factor authentication, and ASP.NET Core helpers (hot reload, ETag file responses).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;AI;Mail;Excel;PDF;OpenIdConnect;EntraID</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>New: semantic search for SemanticSearchField (Codeer.LowCode.Blazor.Extras 0.15.0). SemanticSearchIndexer.ApplyAsync(designData, data, isNewData), called from the ModuleDataIO override (CustomizedModuleDataIO.AddAsync / UpdateAsync as in the app templates), adds the embedding vector to the text sent by the field; for a new record without text (bulk import) it builds the text on the server; when the embedding model is not configured or the call fails the text is saved without a vector and a warning is logged. SemanticSearchIndexer.ReindexAsync(moduleDataIO, dbAccessor, designData, moduleName, missingOnly, progress) rebuilds the index of a module through normal Submit (read and write permissions apply as usual), embedding a page of rows (100 by default) in one call and optionally only the rows that have no vector yet. SemanticSearchReindexJobStore runs it as a background job for the Reindex script of SemanticSearchField: StartAsync checks that the caller can read the field (same rule as the AI chat), the host supplies the job's ModuleDataIO and connection through SemanticSearchReindexScope, and the client polls GetStatus / cancels with Cancel (a thin controller like the AI chat one; see the Example). Vectors are stored as a JSON array text ([0.1,-0.2,...]) that pgvector and SQL Server VECTOR columns cast. The embedding model is an IEmbeddingProvider (ModelId / Dimensions / EmbedAsync(texts)), switchable like the mail senders: the package provides AzureOpenAIEmbeddingProvider, OpenAIEmbeddingProvider and OllamaEmbeddingProvider (local models, plain HTTP, no extra dependency) with one settings class each, plus EmbeddingGeneratorProvider to wrap a Microsoft.Extensions.AI IEmbeddingGenerator; the host picks one by name in a table (see the Example EmbeddingProviderTable and the SemanticSearch.EmbeddingProvider setting) and can add its own implementation. A provider that declares Dimensions makes the indexer fail fast when the returned vectors do not match the database column. New: AzureOpenAIClients.ChatClientFactory(AISettings) builds the IChatClient for Azure OpenAI from AISettings (null when the settings are incomplete); the default constructor of AITextAnalyzeService uses it. RawDataAccessAgent gains an optional constructor parameter embeddingProvider; when it is set and the design has a module with a fully configured SemanticSearchField on a PostgreSQL (pgvector) or SQL Server 2025 data source, the agent gets a search_records(moduleName, query, top) tool that embeds the question and lets the database order the rows by cosine distance (ORDER BY ... LIMIT / TOP), returning Id, score, detail page URL and text of the closest rows. There is no in-memory comparison: modules on other databases are not searchable and a failing database search is returned to the model as an error. On the same data sources the agent may write {embed:text} inside an execute_sql query; RawDataAccessToolSet.SqlPreprocessor (a new hook, wired by RawDataAccessAgent) replaces it with the embedding vector literal of that text before the SELECT check, so similarity can be combined with WHERE, JOIN and aggregation in one SQL. The searchable modules are limited to RawDataAccessOptions.DataSourceNames; per-row DataReadCondition is not applied, same as execute_sql. Requires Codeer.LowCode.Blazor.Extras 0.15.0.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras.Server</PackageId>
		<!-- NU5104: Azure.AI.OpenAI has no stable release built for the OpenAI 2.9+ line yet, so the prerelease dependency is intentional -->
		<NoWarn>$(NoWarn);NU5104</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- internal のテストのみに許可 (製品アセンブリへの IVT は不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- メールプレビュー HTML (MailPreviewHtml が埋め込みから読む) -->
		<EmbeddedResource Include="Mail\MailPreview.html" LogicalName="Codeer.LowCode.Blazor.Extras.Server.Mail.MailPreview.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
		<PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.36.0" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Markdig" Version="0.37.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.8" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
