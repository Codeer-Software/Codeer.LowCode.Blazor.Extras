<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.10.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Server-side services for Codeer.LowCode.Blazor apps. Includes AI document analysis (Azure Document Intelligence + Azure OpenAI), mail sending (SMTP / Microsoft Graph / SendGrid / Gmail), file storage (file system / Azure Blob / S3), external logins (Entra ID / Google / AWS Cognito / OIDC), TOTP two-factor authentication, and ASP.NET Core helpers (hot reload, ETag file responses).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;AI;Mail;Excel;PDF;OpenIdConnect;EntraID</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>AI chat agents for AIChatField (namespace Codeer.LowCode.Blazor.Extras.Server.AI.Chat). IAIChatAgent is the contract; AIChatJobStore runs an agent in the background and answers the field's polling (it takes an agent-name-to-agent table, so no DI registration is required). ChatClientAgent answers with any Microsoft.Extensions.AI IChatClient (Azure OpenAI, OpenAI, Ollama...), keeps per-conversation history keyed by the signed-in user and the conversation id, streams partial replies, and trims history (tool results are dropped from older turns, then by turn count and character budget) to keep token usage bounded. RawDataAccessAgent answers questions about the application's data: it reads the application design (list_modules / describe_module: fields with display names, candidate values, links with join keys, logical-delete columns, scripts and page URLs), reads the supplementary documents selected by the field's DocumentFolder, queries one or more data sources with read-only SQL (a two-level get_schema that returns a table index first and columns only for the requested tables; execute_sql limited to a single SELECT with row/character/time limits and an audit log; SQL dialect per data source), and renders bar/line/pie charts as SVG on the server so numbers are never transcribed by the model. Records in a reply link to their CLB detail page. Access control is done on the database side: point the agent at a data source whose connection uses a read-only DB user (or views) that exposes only the tables and columns the AI may read; the library does not decide permissions. User-facing texts (progress, errors) are localized (en, ja-JP); prompts are Japanese. See docs/AIChatField.md in the repository. Requires Codeer.LowCode.Blazor 1.3.32 or later.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras.Server</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- internal のテストのみに許可 (製品アセンブリへの IVT は不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- メールプレビュー HTML (MailPreviewHtml が埋め込みから読む) -->
		<EmbeddedResource Include="Mail\MailPreview.html" LogicalName="Codeer.LowCode.Blazor.Extras.Server.Mail.MailPreview.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
		<PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.36.0" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Markdig" Version="0.37.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.8" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
