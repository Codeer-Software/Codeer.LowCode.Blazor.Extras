<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.8.5</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Server-side services for Codeer.LowCode.Blazor apps. Includes AI document analysis (Azure Document Intelligence + Azure OpenAI), mail sending (SMTP / Microsoft Graph / SendGrid / Gmail), file storage (file system / Azure Blob / S3), external logins (Entra ID / Google / AWS Cognito / OIDC), and ASP.NET Core helpers (hot reload, ETag file responses).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;AI;Mail;Excel;PDF;OpenIdConnect;EntraID</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>External logins (Codeer.LowCode.Blazor.Extras.Server.Auth): sign in with Microsoft Entra ID, Google, AWS Cognito or any OpenID Connect provider on top of the cookie authentication. AddExternalLogins(...) registers every provider that has a ClientId in the ExternalLogins configuration section; the verified identity is mapped to a user row by the application's IExternalLoginUserResolver, so authorization (user module, UserRead/Write conditions) is unchanged. Includes per-provider validation (Entra UPN / guest rejection / issuer format for multi-tenant, verified e-mail for Google and Cognito, allowed domains), two-step logout that also ends the IdP session, and a one-time ticket flow for native (MAUI) clients that sign in through the system browser. See docs/ExternalLogin.md.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras.Server</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- internal のテストのみに許可 (製品アセンブリへの IVT は不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Codeer.LowCode.Blazor.Extras\Codeer.LowCode.Blazor.Extras.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- メールプレビュー HTML (MailPreviewHtml が埋め込みから読む) -->
		<EmbeddedResource Include="Mail\MailPreview.html" LogicalName="Codeer.LowCode.Blazor.Extras.Server.Mail.MailPreview.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
		<PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.36.0" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.8" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
