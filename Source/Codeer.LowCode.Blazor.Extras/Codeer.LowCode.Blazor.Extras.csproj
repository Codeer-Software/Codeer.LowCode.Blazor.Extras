<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.7.0</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Extra field components and client-side services for Codeer.LowCode.Blazor. Includes Calendar, Gantt Chart, Task Board (Kanban), Rich Text Editor, Color Picker, Marker List, QR Code, Progress Bar, Password Hash, and AI Text Analyzer fields, plus built-in script objects (Excel, WebApi, Toaster, Mail) and client infrastructure services (HTTP, UI, logging, localization).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;Calendar;Gantt;Kanban;TaskBoard;RichText;ColorPicker;QRCode;Progress;PasswordHash</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Designer: the enum values of the Extras design properties (CSV delimiter / encoding / fixed-length width unit, fixed-length alignment and padding character, Excel report format, orientation lock, progress display type and scale, QR code error correction level, approval withdraw policy) are now shown with localized display names in the property grid (requires Codeer.LowCode.Blazor 1.3.23). BREAKING: MailField / BulkMailField no longer have IsFromCurrentUser ("send as the signed-in user"); the sender is always the system sender configured for the mail infrastructure. The MailSenderContractField and GmailTokenField (per-user Gmail refresh tokens stored on the server) are removed, together with GmailTokenTransport; sending from a personal Gmail account is done with the Windows MailSender app (Tools/MailSender in the repository) that keeps the token on the user's PC. MailTransport.Handler and IMailTransportHandler are public so desktop apps can route mail sending / preview without HTTP.</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras</PackageId>
	</PropertyGroup>

	<PropertyGroup>
		<StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
		<StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
	</PropertyGroup>

	<ItemGroup>
		<!-- internal はファミリー内(Server/Designer)とテストにだけ見せる (ファミリー外の製品アセンブリへのIVTは不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Server</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Designer</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.23" />
		<PackageReference Include="QRCoder" Version="1.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.8" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.32.0" />
		<PackageReference Include="Sotsera.Blazor.Toaster" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Properties\Resources.ja-JP.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.ja-JP.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
