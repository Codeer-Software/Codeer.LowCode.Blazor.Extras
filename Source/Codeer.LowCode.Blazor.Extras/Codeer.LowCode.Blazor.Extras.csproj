<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>0.8.3</Version>
		<Authors>Codeer</Authors>
		<Company>Codeer</Company>
		<Description>Extra field components and client-side services for Codeer.LowCode.Blazor. Includes Calendar, Gantt Chart, Task Board (Kanban), Rich Text Editor, Color Picker, Marker List, QR Code, Progress Bar, Password Hash, and AI Text Analyzer fields, plus built-in script objects (Excel, WebApi, Toaster, Mail) and client infrastructure services (HTTP, UI, logging, localization).</Description>
		<PackageProjectUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Codeer-Software/Codeer.LowCode.Blazor.Extras</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;LowCode;Codeer;Calendar;Gantt;Kanban;TaskBoard;RichText;ColorPicker;QRCode;Progress;PasswordHash</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>LoginAccountContractField: a contract field for the current-user module that declares how its rows act as login accounts. Roles (field references): login ID, the field matched against external identity providers, an active flag, a display name and the address for e-mail one-time-code two-factor login. Write-only login columns: password hash / salt (for verification; PasswordHashField stays the field that writes them) and the three TOTP columns (secret / confirmed / last time step) for authenticator-app two-factor login. The template login (Codeer.LowCode.Blazor.Extras.Server 0.8.5) reads only this contract.
LoginAccountContractField: a contract field for the current-user module that declares how its rows act as login accounts: login ID (required), the field matched against external identity providers, an active flag and a display name. The templates' login (Codeer.LowCode.Blazor.Extras.Server.Auth.LoginAccountStore) resolves the user table and columns from the module design (IdField, this contract, PasswordHashField) instead of a PasswordCheckUserTableInfo section in appsettings. Existing designs and hosts keep working; add the contract when moving a design to the new templates.
TotpResetButtonField (login user module: removes the authenticator-app registration of the displayed user by writing the three TOTP columns through the normal Submit, so the usual write permissions apply) and MyTotpResetButtonField (any module: removes the signed-in user's own registration; wire TotpResetClient.StatusEndPoint / ResetEndPoint to the host endpoints, the templates provide them).</PackageReleaseNotes>
		<PackageId>Codeer.LowCode.Blazor.Extras</PackageId>
	</PropertyGroup>

	<PropertyGroup>
		<StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
		<StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
	</PropertyGroup>

	<ItemGroup>
		<!-- internal はファミリー内(Server/Designer)とテストにだけ見せる (ファミリー外の製品アセンブリへのIVTは不可) -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Server</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Designer</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Codeer.LowCode.Blazor.Extras.Test</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.27" />
		<PackageReference Include="QRCoder" Version="1.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.8" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Excel.Report.PDF" Version="0.36.0" />
		<PackageReference Include="Sotsera.Blazor.Toaster" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Properties\Resources.ja-JP.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.ja-JP.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
