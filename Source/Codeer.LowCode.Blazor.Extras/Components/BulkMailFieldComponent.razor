@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Extras.Fields
@using Codeer.LowCode.Blazor.OperatingModel
@using Microsoft.AspNetCore.Components.Web
@inherits FieldComponentBase<BulkMailField>

<div data-system="bulk-mail">
  <button type="button" class="btn btn-outline-primary" style="@Field.GetOwnStyleString()"
          disabled="@(Field.IsSending || !Field.IsEnabled)"
          @onclick="@(async () => await Field.SendFromButtonAsync())"
          aria-label="Bulk Mail">
    <i class="bi bi-envelope" aria-hidden="true"></i>
    @ButtonText
  </button>
</div>

@code {
  string ButtonText => string.IsNullOrEmpty(Field.Design.ButtonText)
    ? Codeer.LowCode.Blazor.Extras.Properties.Resources.BulkMailDefaultButtonText
    : Field.Design.ButtonText;
}
