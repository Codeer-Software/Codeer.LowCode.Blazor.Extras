@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Extras.Fields
@using Codeer.LowCode.Blazor.OperatingModel
@using Microsoft.AspNetCore.Components.Web
@inherits FieldComponentBase<BulkMailField>

@*送信 / プレビューのアイコンだけのボタングループ。文字付きのボタンが要るアプリは ButtonField + スクリプト (Send / Preview) で作る*@
<div data-system="bulk-mail" class="btn-group" role="group" style="@Field.GetOwnStyleString()">
  <button type="button" class="btn btn-outline-primary px-2"
          disabled="@(Field.IsSending || !Field.IsEnabled)"
          @onclick="@(async () => await Field.SendFromButtonAsync())"
          title="@Codeer.LowCode.Blazor.Extras.Properties.Resources.MailFieldSendButtonTitle"
          aria-label="@Codeer.LowCode.Blazor.Extras.Properties.Resources.MailFieldSendButtonTitle">
    <i class="bi bi-send" aria-hidden="true"></i>
  </button>
  @if (Field.Design.ShowPreviewButton)
  {
    <button type="button" class="btn btn-outline-primary px-2"
            disabled="@(Field.IsSending || !Field.IsEnabled)"
            @onclick="@(async () => await Field.PreviewAsync())"
            title="@Codeer.LowCode.Blazor.Extras.Properties.Resources.MailFieldPreviewButtonText"
            aria-label="@Codeer.LowCode.Blazor.Extras.Properties.Resources.MailFieldPreviewButtonText">
      <i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i>
    </button>
  }
</div>
