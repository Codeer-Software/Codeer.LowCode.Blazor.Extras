@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Components.Fields
@using Codeer.LowCode.Blazor.Extras.Fields
@using Microsoft.AspNetCore.Components.Web
@inherits FieldComponentBase<TotpResetButtonField>

@* 登録済みかどうかは分からない (列は書き込み専用) のでボタンだけ。新規行では出さない。デザインモードでは形だけ出す *@
@if (IsDesignMode)
{
  <button type="button" class="btn btn-outline-danger btn-sm" disabled data-system="totp-reset">@Field.ButtonText</button>
}
else if (Field.CanReset)
{
  <button type="button" class="btn btn-outline-danger btn-sm" style="@Field.GetOwnStyleString()" disabled="@Field.IsBusy"
          @onclick="@(async () => await Field.ResetAsync())" data-system="totp-reset">@Field.ButtonText</button>
}

@code {
  bool IsDesignMode => Field.Services.AppInfoService.IsDesignMode;
}
