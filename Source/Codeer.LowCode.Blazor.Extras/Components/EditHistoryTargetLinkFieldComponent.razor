@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Extras.Fields
@using Microsoft.AspNetCore.Components.Web
@inherits FieldComponentBase<EditHistoryTargetLinkField>

@* 開ける行 (対象モジュールがあり、削除の版でない) でだけ出す。デザインモードでは形だけ出す *@
@if (Field.Services.AppInfoService.IsDesignMode)
{
  <span class="edit-history-target-link" data-system="edit-history-target-link">@Field.LinkText</span>
}
else
{
  var url = Field.TargetUrl;
  @if (!string.IsNullOrEmpty(url))
  {
    @* 一覧の行に置いたとき、行の選択 (クリック) を起こさない *@
    <a class="edit-history-target-link" href="@url" style="@Field.GetOwnStyleString()"
       data-system="edit-history-target-link" @onclick:stopPropagation="true">@Field.LinkText</a>
  }
}
