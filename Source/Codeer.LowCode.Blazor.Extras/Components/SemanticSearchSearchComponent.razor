@using Microsoft.AspNetCore.Components.Web
@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Components.Fields
@using Codeer.LowCode.Blazor.Extras.Designs
@using Codeer.LowCode.Blazor.Extras.Fields
@using Codeer.LowCode.Blazor.Extras.Properties
@inherits FieldComponentBase<SemanticSearchField>

@* 検索レイアウトの検索欄: 探したい内容を文章で入れる (埋め込みはサーバーが作る) と、キーワード欄 (語をすべて含む行に絞る)。どちらを出すかは SearchBoxes *@
<div style="display: grid; gap: 4px;">
  @if (!KeywordOnly)
  {
    <input type="text" class="form-control @(Field.GetValidationClassName())" placeholder="@Resources.SemanticSearch_SearchPlaceholder"
           @bind:get="Field.SearchText" @bind:set="OnChange" @ref="Element" id="@WebElementId" disabled="@(Field.IsEnabled == false)" style="@Field.GetOwnStyleString()" data-role="semantic-search-text" />
  }
  @if (Field.Design.SearchBoxes != SemanticSearchBoxes.Semantic)
  {
    <input type="text" class="form-control @(Field.GetValidationClassName())" placeholder="@Resources.SemanticSearch_KeywordPlaceholder"
           @bind:get="Field.KeywordText" @bind:set="OnKeywordChange" @ref="_keywordElement" id="@(KeywordOnly ? WebElementId : WebElementId + "_keyword")" disabled="@(Field.IsEnabled == false)" style="@Field.GetOwnStyleString()" data-role="semantic-search-keyword" />
  }
</div>

@code {
  ElementReference _keywordElement;

  bool KeywordOnly => Field.Design.SearchBoxes == SemanticSearchBoxes.KeywordOnly;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    //文章の欄を出さないときはキーワード欄がこのフィールドの要素 (フォーカス・位置の基準・id)
    if (KeywordOnly) Element = _keywordElement;
    await base.OnAfterRenderAsync(firstRender);
  }

  private async Task OnChange(string? value)
  {
    await Field.SetSearchTextAsync(value);
  }

  private async Task OnKeywordChange(string? value)
  {
    await Field.SetKeywordTextAsync(value);
  }
}
