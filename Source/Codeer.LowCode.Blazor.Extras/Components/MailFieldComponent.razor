@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Extras.Fields
@using Codeer.LowCode.Blazor.OperatingModel
@using Microsoft.AspNetCore.Components.Web
@inherits FieldComponentBase<MailField>

<div data-system="mail">
  <button type="button" class="btn btn-outline-primary" style="@StyleString"
          disabled="@(Field.IsSending || !Field.IsEnabled)"
          @onclick="@(async () => await Field.SendFromButtonAsync())"
          aria-label="Mail">
    <i class="bi bi-envelope" aria-hidden="true"></i>
    @ButtonText
  </button>
</div>

@code {
  string ButtonText => string.IsNullOrEmpty(Field.Design.ButtonText)
    ? Codeer.LowCode.Blazor.Extras.Properties.Resources.MailFieldDefaultButtonText
    : Field.Design.ButtonText;

  //自分に明示設定されたスタイルだけ出力する (コアの GetStyleString と同じ規約)
  string? StyleString
  {
    get
    {
      var drawStyle = Field.GetOwnStyles();
      var style = string.Empty;
      if (drawStyle.HasFlag(DrawStyle.BackgroundColor)) style += $"background-color: {Field.BackgroundColor};";
      if (drawStyle.HasFlag(DrawStyle.Color)) style += $"color: {Field.Color};";
      return style.Length == 0 ? null : style;
    }
  }
}
