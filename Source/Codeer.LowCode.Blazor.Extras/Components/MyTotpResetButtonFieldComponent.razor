@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Components.Fields
@using Codeer.LowCode.Blazor.Extras.Fields
@using Microsoft.AspNetCore.Components.Web
@inherits FieldComponentBase<MyTotpResetButtonField>

@* 認証アプリの二要素認証を使っていない (Enabled=false)・状態未取得なら何も出さない。デザインモードでは形だけ出す *@
@if (IsDesignMode)
{
  <span class="d-inline-flex align-items-center gap-2">
    <span class="small text-muted">@Field.StatusText</span>
    <button type="button" class="btn btn-outline-danger btn-sm" disabled data-system="my-totp-reset">@Field.ButtonText</button>
  </span>
}
else if (Field.IsRegistered != null)
{
  <span class="d-inline-flex align-items-center gap-2" style="@Field.GetOwnStyleString()">
    <span class="small text-muted" data-system="my-totp-status">@Field.StatusText</span>
    @if (Field.IsRegistered == true)
    {
      <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(Field.IsBusy || !Field.IsEnabled)"
              @onclick="@(async () => await Field.ResetAsync())" data-system="my-totp-reset">@Field.ButtonText</button>
    }
  </span>
}

@code {
  bool IsDesignMode => Field.Services.AppInfoService.IsDesignMode;

  protected override async Task OnParametersSetAsync()
  {
    await base.OnParametersSetAsync();
    await Field.EnsureStatusAsync();
  }
}
