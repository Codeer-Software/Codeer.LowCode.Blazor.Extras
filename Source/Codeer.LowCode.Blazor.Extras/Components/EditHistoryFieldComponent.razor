@using Codeer.LowCode.Blazor.Components
@using Codeer.LowCode.Blazor.Extras.EditHistory
@using Codeer.LowCode.Blazor.Extras.Fields
@using Microsoft.AspNetCore.Components.Web
@using R = Codeer.LowCode.Blazor.Extras.Properties.Resources
@inherits FieldComponentBase<EditHistoryField>
@if (Field.Services.AppInfoService.IsDesignMode)
{
  <div data-system="edit-history" class="edit-history">
    <span class="edit-history-note">@R.EditHistoryDesignPlaceholder</span>
  </div>
}
else if (!Field.IsAvailable)
{
  <div data-system="edit-history" class="edit-history">
    <span class="edit-history-note">@R.EditHistoryNotSavedYet</span>
  </div>
}
else
{
  @* 「この版を表示」のダイアログは本コンポーネントの外に描画されるため、強調のスタイルはグローバルに出す *@
  <style>
    .@(EditHistoryField.ChangedClassName) {
      outline: 2px solid #8fd19e;
      outline-offset: 2px;
      border-radius: 4px;
      background-color: rgba(143, 209, 158, 0.15);
    }
    /* 一覧のセルはスクロール枠の端で外側の枠が切れるので、内側に描く */
    td.@(EditHistoryField.ChangedClassName) {
      outline: none;
      border-radius: 0;
      box-shadow: inset 0 0 0 2px #8fd19e;
    }
    .@(EditHistoryField.AddedRowClassName),
    .@(EditHistoryField.AddedRowClassName) > td {
      background-color: rgba(143, 209, 158, 0.25);
    }
    .@(EditHistoryField.RemovedRowClassName),
    .@(EditHistoryField.RemovedRowClassName) > td {
      background-color: rgba(220, 53, 69, 0.10);
    }
    .@(EditHistoryField.RemovedRowClassName) td,
    .@(EditHistoryField.RemovedRowClassName) span,
    .@(EditHistoryField.RemovedRowClassName) input {
      text-decoration: line-through;
      color: #842029;
    }
    /* 従属レコードの項目 (Gantt のタスク・カレンダーの予定・カード・マーカー): 追加 = 背景 / 変更 = 枠 / 削除 = 打ち消し。
       セル単位の強調が出ない項目なので項目ごとに付ける。一覧の行 (tr) は上のセル単位の強調を使うので対象外 */
    :not(tr).@(EditHistoryField.ChangedRowClassName) {
      box-shadow: inset 0 0 0 2px #8fd19e;
    }
    .@(EditHistoryField.RemovedRowClassName) .label,
    .@(EditHistoryField.RemovedRowClassName) .gantt-label-text {
      text-decoration: line-through;
      color: #842029;
    }
    .marker.@(EditHistoryField.AddedRowClassName) .circle,
    .marker.@(EditHistoryField.ChangedRowClassName) .circle {
      box-shadow: 0 0 0 3px #8fd19e;
    }
    .marker.@(EditHistoryField.RemovedRowClassName) .circle {
      box-shadow: 0 0 0 3px #dc3545;
      opacity: 0.5;
    }
    /* Gantt のバーは svg (background は効かない) なので枠線で出す */
    rect.gantt-task-bar.@(EditHistoryField.AddedRowClassName),
    rect.gantt-task-bar.@(EditHistoryField.ChangedRowClassName) {
      stroke: #198754;
      stroke-width: 2px;
    }
    rect.gantt-task-bar.@(EditHistoryField.RemovedRowClassName) {
      stroke: #dc3545;
      stroke-width: 2px;
      stroke-dasharray: 4 2;
      fill-opacity: 0.2 !important;
    }
    /* 版表示ダイアログ: 本体のダイアログは中身の幅 (fit-content) で、表示専用の文字だけだと版ごとに幅が変わるので最小幅を持たせる */
    .modal-dialog:has(.@(EditHistoryField.VersionDialogClassName)) {
      min-width: min(90vw, 1000px);
    }
  </style>
  <div data-system="edit-history" class="edit-history">
    @if (!Field.IsLoaded)
    {
      <span class="edit-history-note">@R.EditHistoryLoading</span>
    }
    else if (Field.Versions.Count == 0)
    {
      <span class="edit-history-note">@R.EditHistoryNoHistory</span>
    }
    else
    {
      <div class="edit-history-versions" data-system="edit-history-versions">
      @foreach (var version in Field.Versions)
      {
        @* 版ごとに折りたたみ。閉じた状態は見出しと要約だけ、開くと差分と操作。
           @key: 新しい版が先頭に入っても DOM を版ごとに保つ (開いた状態が次の版に移らない) *@
        <details class="edit-history-version" data-system="edit-history-version" @key="version.Id">
          <summary class="edit-history-head">
            <span class="edit-history-number">@string.Format(R.EditHistoryVersionFormat, version.Number)</span>
            <span class="edit-history-type edit-history-type-@version.ChangeType.ToLowerInvariant()">@ChangeTypeText(version)</span>
            @if (!string.IsNullOrEmpty(version.UserText))
            {
              <span class="edit-history-user">@version.UserText</span>
            }
            @if (version.DateTime != null)
            {
              <span class="edit-history-date">@version.DateTime.Value.ToString("g")</span>
            }
            <span class="edit-history-summary">@VersionSummary(version)</span>
          </summary>
          <div class="edit-history-body">
            @if (!version.IsDelete && !version.IsRestore && !version.IsAdd && version.HasPreviousVersion && version.Changes.Count > 0)
            {
              <div class="edit-history-changes">
                @foreach (var change in version.Changes)
                {
                  @RenderChange(change)
                }
              </div>
            }
            @if (!string.IsNullOrEmpty(version.Command))
            {
              @* 受け取った操作 (監査用の生データ)。差分とは別に、送られてきたものをそのまま見せる *@
              <details class="edit-history-command" data-system="edit-history-command">
                <summary>@R.EditHistoryCommand</summary>
                <pre class="edit-history-command-json">@PrettyJson(version.Command)</pre>
              </details>
            }
            @if (version.Snapshot != null)
            {
              <div class="edit-history-actions">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-system="edit-history-show"
                        disabled="@Field.IsBusy" @onclick="@(async () => await Field.ShowVersionAsync(version))">@R.EditHistoryShowVersion</button>
                @if (Field.CanRestore && !version.IsDelete && version.Number != Field.TotalCount)
                {
                  <button type="button" class="btn btn-sm btn-outline-primary" data-system="edit-history-restore"
                          disabled="@Field.IsBusy" @onclick="@(async () => await Field.RestoreAsync(version))">@R.EditHistoryRestoreVersion</button>
                }
              </div>
            }
          </div>
        </details>
      }
      </div>
      @if (Field.HasMore)
      {
        <button type="button" class="btn btn-sm btn-link edit-history-more" data-system="edit-history-more"
                disabled="@Field.IsBusy" @onclick="@(async () => await Field.LoadMoreAsync())">@R.EditHistoryLoadMore</button>
      }
    }
  </div>
}

@code {
  //表示用に整形する (保存は 1 行の JSON)。JSON でなければそのまま
  static string PrettyJson(string json)
  {
    try
    {
      using var doc = System.Text.Json.JsonDocument.Parse(json);
      return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions
      {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
      });
    }
    catch
    {
      return json;
    }
  }

  RenderFragment RenderChange(EditHistoryChange change, EditHistoryRowChangeKind? rowKind = null) => __builder =>
  {
    @if (!change.IsList && !change.HasValueText)
    {
      <div class="edit-history-change">
        <span class="edit-history-field">@change.DisplayName</span>
        <span class="edit-history-note">@R.EditHistoryChangedNoText</span>
      </div>
    }
    else if (!change.IsList && rowKind == EditHistoryRowChangeKind.Added)
    {
      @* 追加された行の値: 新しい値だけ *@
      <div class="edit-history-change">
        <span class="edit-history-field">@change.DisplayName</span>
        <span class="edit-history-value edit-history-after">@ValueText(change.After)</span>
      </div>
    }
    else if (!change.IsList && rowKind == EditHistoryRowChangeKind.Removed)
    {
      @* 削除された行の値: 打ち消し *@
      <div class="edit-history-change">
        <span class="edit-history-field">@change.DisplayName</span>
        <span class="edit-history-value edit-history-before">@ValueText(change.Before)</span>
      </div>
    }
    else if (!change.IsList)
    {
      <div class="edit-history-change">
        <span class="edit-history-field">@change.DisplayName</span>
        <span class="edit-history-value edit-history-before">@ValueText(change.Before)</span>
        <span class="edit-history-arrow">→</span>
        <span class="edit-history-value edit-history-after">@ValueText(change.After)</span>
      </div>
    }
    else
    {
      <div class="edit-history-change edit-history-list" @key="change.FieldName">
        <span class="edit-history-field">@change.DisplayName</span>
        <span class="edit-history-list-summary">@ListSummary(change)</span>
        <div class="edit-history-rows">
          @foreach (var row in change.Rows)
          {
            <div class="edit-history-row edit-history-row-@row.Kind.ToString().ToLowerInvariant()">
              <span class="edit-history-row-kind">@RowKindText(row.Kind)</span>
              <span class="edit-history-row-number">@string.Format(R.EditHistoryRowNumberFormat, row.RowNumber)</span>
              @foreach (var nested in row.Changes)
              {
                @RenderChange(nested, row.Kind)
              }
            </div>
          }
        </div>
      </div>
    }
  };

  static string ValueText(string value) => string.IsNullOrEmpty(value) ? R.EditHistoryNoValue : value;

  //閉じた状態の要約: 作成 / 削除 / 復活 / 前の版なし / 変更なし / 変更 n 項目: 名前, 名前, …
  static string VersionSummary(EditHistoryVersion version)
  {
    if (version.IsDelete) return R.EditHistoryRecordDeleted;
    if (version.IsRestore) return R.EditHistoryRecordRestored;
    if (version.IsAdd) return R.EditHistoryRecordCreated;
    if (!version.HasPreviousVersion) return R.EditHistoryNoPreviousVersion;
    if (version.Changes.Count == 0) return R.EditHistoryNoVisibleChanges;
    var names = version.Changes.Select(e => e.DisplayName).Take(3).ToList();
    var suffix = version.Changes.Count > 3 ? ", …" : string.Empty;
    return string.Format(R.EditHistoryChangedFieldsFormat, version.Changes.Count, string.Join(", ", names) + suffix);
  }

  static string ChangeTypeText(EditHistoryVersion version)
    => Enum.TryParse<EditHistoryChangeType>(version.ChangeType, out var type)
      ? type switch
      {
        EditHistoryChangeType.Add => R.EditHistoryChangeType_Add,
        EditHistoryChangeType.Delete => R.EditHistoryChangeType_Delete,
        EditHistoryChangeType.Restore => R.EditHistoryChangeType_Restore,
        _ => R.EditHistoryChangeType_Update,
      }
      : version.ChangeType;

  static string RowKindText(EditHistoryRowChangeKind kind) => kind switch
  {
    EditHistoryRowChangeKind.Added => R.EditHistoryRowAdded,
    EditHistoryRowChangeKind.Removed => R.EditHistoryRowRemoved,
    _ => R.EditHistoryRowChanged,
  };

  static string ListSummary(EditHistoryChange change)
  {
    var parts = new List<string>();
    if (change.AddedCount > 0) parts.Add(string.Format(R.EditHistoryRowsAddedFormat, change.AddedCount));
    if (change.RemovedCount > 0) parts.Add(string.Format(R.EditHistoryRowsRemovedFormat, change.RemovedCount));
    if (change.ChangedCount > 0) parts.Add(string.Format(R.EditHistoryRowsChangedFormat, change.ChangedCount));
    return string.Join(" / ", parts);
  }
}
